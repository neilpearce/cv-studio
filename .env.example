# Postgres connection string. Use Neon (free): https://neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# Production URL of your deployment (set in Vercel — not needed locally)
# AUTH_URL="https://mycvstudio.co.uk"

# Optional: Google OAuth. Leave blank to disable Google sign-in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
